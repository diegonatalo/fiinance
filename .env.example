# Copie este arquivo para .env.local e preencha. Na Vercel, as mesmas variáveis
# ficam em Settings > Environment Variables.

# URL pública do site, usada nas tags Open Graph, no canonical, no robots.txt e no sitemap.xml (sem barra no final).
NEXT_PUBLIC_SITE_URL=https://fiinance1.vercel.app

# Banco Postgres (Neon). Em desenvolvimento, use a URL de uma branch "dev", não a de produção.
# O nome do banco precisa terminar em _dev: fora disso, o `pnpm dev`, o E2E e o `db:migrate` param (lib/dev-database.ts).
# A versão sem pooler é usada pelas migrações (`pnpm db:migrate`); se faltar, vale a DATABASE_URL.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Better Auth. O segredo assina os cookies de sessão: gere um com `openssl rand -base64 32`
# e use um diferente em cada ambiente. A URL é o endereço local, sem barra no final; na Vercel não precisa,
# porque o app usa o SITE_URL (lib/site.ts).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
