# URL pública do site, sem barra final. Usada para gerar sitemap.xml, robots.txt
# e as URLs absolutas das imagens Open Graph.
NEXT_PUBLIC_SITE_URL=https://seudominio.com

# Token da brapi (https://brapi.dev), só no servidor: as cotações dos FIIs passam
# pela rota /api/quotes. Sem ele, o app funciona, mas sem cotações.
BRAPI_TOKEN=
